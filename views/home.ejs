<html lang="en">
<head>
    <title>Albums Home</title>
    <%- include('./partials/head'); %>
</head>
<body  class="container">
<header>
    <%- include('./partials/header'); %>
</header>
<h2>Home</h2>
<hr>
<h3>Music Collection</h3>
<h4>Artists</h4>
<div class="albumContainer" style="background-color: powderblue">
<% albums.forEach(function(album) { %>
    <li style="list-style: none"><a style="color: darkblue" href="/detail?artist=<%= album.artist %>"> <%= album.artist %></a></li>
<% }); %>
</div>
<footer>
    <%- include('./partials/footer'); %>
</footer>
</body>
</html>