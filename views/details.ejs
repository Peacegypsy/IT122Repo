<html lang="en">
<head>
    <title>Album Details</title>
    <%- include('./partials/head'); %>
</head>
<body class="container">
<header>
    <%- include('./partials/header'); %>
</header>
<div class="albumContainer" style="background-color: powderblue">
<% if (album) { %>
    <h3>Artist: <%= album.artist %> </h3>

    <h4>Album Name: <%= album.albumTitle %></h4>
    <h5>Songs</h5>
        <hr>
    <% album.songs.forEach( function(song) { %>
        <li style="list-style: none"><%= song %></li>
    <% }); %>
<% } else { %>
    <p><em>No artist found.</em></p>
<% } %>
<hr>
    <div>Delete Album:   </div>
<a href="/delete?albumTitle=<%= album.albumTitle %>" class="delete"><%= album.albumTitle %></a></div>
<footer>
    <%- include('./partials/footer'); %>
</footer>
</body>
</html>