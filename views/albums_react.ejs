<html lang="en">
<head>
    <title>Albums Home</title>
    <%- include('./partials/head'); %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>

    <!-- Don't use this in production: -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="container">
<header>
    <%- include('./partials/header'); %>
</header>
<div id="root"></div>
<script type="text/babel">

    const ArtistList = (props) => {
        const listAlbums = props.albums.map((album) =>
            <li key={album._id} id={album._id} onClick={props.clickHandler}> {album.artist} </li>);
        return <ul>{listAlbums}</ul>
    }

    const ArtistDetail = (props) => {
        return (
            <div>
                <h3>Artist Details:</h3>
                <form>
                    <h5 id="note"></h5>
                    <label>Name: <input type="text" name="artist" value={props.album.artist || ""} onChange={props.handleChange}/> </label><br/>
                    <label>Album Title: <input type="text" name="albumTitle" value={props.album.albumTitle || ""} onChange={props.handleChange} /></label><br/>
                    <label>Songs: <input type="array" name="songs" value={props.album.songs || ""} onChange={props.handleChange} /></label><br/>
                </form>
                <button onClick={props.saveNewAlbum}>Save</button>&nbsp;
                <button onClick={props.handleReset}>Reset</button>&nbsp;
                <button onClick={props.deleteAlbum}>Delete</button>
            </div>
        )
    }

    const App = (props) => {
        const [albums, setAlbums] = React.useState([]);
        const [currentAlbum, setCurrentAlbum] = React.useState({});
        const [showSuccessMessage, setShowSuccessMessage] = React.useState(false);

        React.useEffect(() => {
            const fetchAlbums = async () => {
                fetch('api/albums').then(res => res.json())
                    .then((json) => {
                        setAlbums(json);
                    })
            }
            fetchAlbums()
        }, []);

        const selectArtist = (event) => {
            const found = albums.find((album) => {
                return album.artist === event.target.innerText;
            });
            return setCurrentAlbum(found);
        }

        const handleReset = () => {
            setCurrentAlbum({});
        }

        const saveNewAlbum = (props) => {
            if(!currentAlbum.artist) {
                return;
            }
            fetch('api/addAlbum', {method: 'POST', headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(currentAlbum)
                })
                .then((res) => res.json())
                .then((album) => {
                    if(!currentAlbum._id) {
                        const na = currentAlbum;
                        na._id = album._id;
                        setCurrentAlbum(na);
                        let updatedAlbums = [...albums];
                        updatedAlbums.push(na);
                        return setAlbums(updatedAlbums);
                    }
                });
        };

        const deleteAlbum = (props) => {
            let id = currentAlbum._id;
            fetch(`/api/albums/delete/${id}`)
                .then((res) => res.json())
                .then((album) => {
                    const newAlbums = albums.filter((album) => {
                        return album._id !== id;
                    });
                    setAlbums(newAlbums);
                    setCurrentAlbum({});
                    setShowSuccessMessage(true);
                    setTimeout(() => {
                        setShowSuccessMessage(false);
                    }, 3000);
                })
        };

        const albumChange = (event) => {
            let newChange = {...currentAlbum};
            newChange[event.target.name] = event.target.value;
            setCurrentAlbum(newChange);

            albums.find((album, index) => {
                if (album._id === newChange._id) {
                    albums[index] = newChange;
                    setAlbums(albums);
                }
            })
        }

        return (
            <div>
                <h4>Artist/Album Details</h4>
                <ArtistList albums={albums} clickHandler={selectArtist} />
                <ArtistDetail album={currentAlbum} handleChange={albumChange} saveNewAlbum={saveNewAlbum} handleReset={handleReset} deleteAlbum={deleteAlbum} />
                {showSuccessMessage && (<div className="success-message">Album deleted successfully!</div>)}
            </div>
        )
    }

    const container = document.getElementById("root");
    const root = ReactDOM.createRoot(container);
    root.render(<App />);
</script>

<footer>
    <%- include('./partials/footer'); %>
</footer>
</body>
</html>